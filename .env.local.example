# Supabase — copie esses valores do painel: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Kiwify webhook — token de segurança para validar requisições
# Configure em: Kiwify Dashboard → Configurações → Webhooks → Token de segurança
# Coloque o mesmo valor aqui e no campo do Kiwify
KIWIFY_WEBHOOK_TOKEN=seu_token_secreto_aqui
